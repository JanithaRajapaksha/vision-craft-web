# ==============================================================================
# Workshop OS – Environment Variables Example
# Duplicate this file to .env and configure for your local/production environment
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="Workshop OS"
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
POSTGRES_USER=workshop_admin
POSTGRES_PASSWORD=workshop_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workshop_os_db
DATABASE_URL=postgresql+asyncpg://workshop_admin:workshop_secure_pass@localhost:5432/workshop_os_db

# --- Background Processing (Redis & Celery) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Storage Provider (local or s3) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/home/janitha/vision-craft-web/storage_data

# S3 / MinIO Configuration (Optional - for production migration)
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=workshop-os-assets
S3_REGION=ap-south-1

# --- Slicer CLI Paths ---
PRUSA_SLICER_PATH=/usr/bin/prusa-slicer
ORCA_SLICER_PATH=/usr/bin/orca-slicer
SLICER_DEFAULT_ENGINE=PRUSA_SLICER
SLICER_TIMEOUT_SECONDS=120

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Workshop OS"
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs. "
